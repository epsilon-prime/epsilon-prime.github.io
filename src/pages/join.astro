---
import BaseLayout from '../layouts/BaseLayout.astro';
import { paths } from '../lib/paths';
---

<BaseLayout title="Join" description="Join Epsilon Prime Research.">
  <h1 class="page-title">Join the lab</h1>
  <p class="page-intro">
    We welcome students and collaborators interested in AI efficiency — making models cheaper, faster,
    and leaner without giving up quality.
  </p>

  <section class="panel">
    <h2>What we look for</h2>
    <p>
      Interest in efficient ML systems, strong coding and math foundations, and curiosity about measuring
      real compute–quality tradeoffs.
    </p>
  </section>

  <section class="panel">
    <h2>How to apply</h2>
    <p>
      Email <a href="mailto:apdesai@cse.iitb.ac.in">apdesai[at]cse.iitb.ac.in</a> with a CV, a short note on
      your interests, and any relevant links (GitHub, papers, projects). See our
      <a href={paths.projects}>projects</a> and <a href={paths.people}>people</a> for context.
    </p>
  </section>
</BaseLayout>
