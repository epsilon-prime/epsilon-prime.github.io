---
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderMedia from '../../components/PlaceholderMedia.astro';
import { paths } from '../../lib/paths';

export async function getStaticPaths() {
  const demos = await getCollection('demos');
  return demos.map((demo) => ({
    params: { slug: demo.id },
    props: { demo },
  }));
}

const { demo } = Astro.props;
const { Content } = await render(demo);
const projects = await getEntries(demo.data.projects);
const papers = await getEntries(demo.data.papers);
const posts = await getEntries(demo.data.posts);
---

<BaseLayout title={demo.data.title} description={demo.data.summary}>
  <p class="eyebrow">Demo</p>
  <h1 class="page-title">{demo.data.title}</h1>
  <p class="page-intro">{demo.data.summary}</p>

  <PlaceholderMedia label="Placeholder demo embed / screenshot" />

  {
    demo.data.demoUrl && (
      <p>
        <a class="btn btn-primary" href={demo.data.demoUrl} rel="noopener noreferrer">
          Open demo
        </a>
      </p>
    )
  }

  <div class="prose">
    <Content />
  </div>

  {
    projects.length > 0 && (
      <section class="panel">
        <h2>Projects</h2>
        <ul class="rel-list">
          {projects.map((project) => (
            <li>
              <a href={paths.project(project.id)}>{project.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    papers.length > 0 && (
      <section class="panel">
        <h2>Papers</h2>
        <ul class="rel-list">
          {papers.map((paper) => (
            <li>
              <a href={paths.paper(paper.id)}>{paper.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="panel">
        <h2>Blogs & tutorials</h2>
        <ul class="rel-list">
          {posts.map((post) => (
            <li>
              <a href={paths.post(post.id)}>
                {post.data.title} <span class="meta">({post.data.type})</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
