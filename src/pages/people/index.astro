---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonPhoto from '../../components/PersonPhoto.astro';
import { paths } from '../../lib/paths';

const people = (await getCollection('people')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="People" description="Members of Epsilon Prime Research.">
  <h1 class="page-title">People</h1>
  <p class="page-intro">
    Lab members and collaborators.
    <a href={paths.join}>Interested in joining?</a>
  </p>
  <div class="grid-3">
    {
      people.map((person) => (
        <div class="list-item person-card">
          <a class="person-card-main" href={paths.person(person.id)}>
            <PersonPhoto name={person.data.name} photo={person.data.photo} />
            <h3>{person.data.name}</h3>
            <p class="meta">{person.data.role}</p>
            {person.data.affiliation && <p class="meta">{person.data.affiliation}</p>}
          </a>
          {
            person.data.website && (
              <a
                class="person-external"
                href={person.data.website}
                rel="noopener noreferrer"
                target="_blank"
              >
                Personal page
              </a>
            )
          }
        </div>
      ))
    }
  </div>
</BaseLayout>
